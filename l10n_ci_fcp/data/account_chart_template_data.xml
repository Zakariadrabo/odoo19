<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        
        <!-- Plan Comptable Template pour FCP Côte d'Ivoire -->
        <record id="ci_fcp_chart_template" model="account.chart.template">
            <field name="name">Plan Comptable FCP - Côte d'Ivoire (SYSCOHADA)</field>
            <field name="code_digits">6</field>
            <field name="bank_account_code_prefix">521</field>
            <field name="cash_account_code_prefix">571</field>
            <field name="transfer_account_code_prefix">580</field>
            <field name="currency_id" ref="base.XOF"/>
            <field name="spoken_languages">fr_FR</field>
        </record>

        <!-- Comptes Racines -->
        <record id="ci_fcp_chart_root" model="account.account.template">
            <field name="name">Plan Comptable FCP CI</field>
            <field name="code">0</field>
            <field name="account_type">equity</field>
            <field name="chart_template_id" ref="ci_fcp_chart_template"/>
        </record>

        <!-- Classe 1: Comptes de Capitaux -->
        <record id="ci_fcp_class1" model="account.account.template">
            <field name="name">COMPTES DE CAPITAUX</field>
            <field name="code">1</field>
            <field name="account_type">equity</field>
            <field name="chart_template_id" ref="ci_fcp_chart_template"/>
        </record>

        <!-- Classe 2: Comptes d'Actifs Immobilisés -->
        <record id="ci_fcp_class2" model="account.account.template">
            <field name="name">COMPTES D'ACTIFS IMMOBILISES</field>
            <field name="code">2</field>
            <field name="account_type">asset_non_current</field>
            <field name="chart_template_id" ref="ci_fcp_chart_template"/>
        </record>

        <!-- Classe 3: Comptes de Portefeuille-Titres -->
        <record id="ci_fcp_class3" model="account.account.template">
            <field name="name">COMPTES DE PORTEFEUILLE-TITRES</field>
            <field name="code">3</field>
            <field name="account_type">asset_current</field>
            <field name="chart_template_id" ref="ci_fcp_chart_template"/>
        </record>

        <!-- Classe 4: Comptes de Tiers -->
        <record id="ci_fcp_class4" model="account.account.template">
            <field name="name">COMPTES DE TIERS</field>
            <field name="code">4</field>
            <field name="account_type">asset_current</field>
            <field name="chart_template_id" ref="ci_fcp_chart_template"/>
        </record>

        <!-- Classe 5: Comptes de Trésorerie -->
        <record id="ci_fcp_class5" model="account.account.template">
            <field name="name">COMPTES DE TRESORERIE</field>
            <field name="code">5</field>
            <field name="account_type">asset_current</field>
            <field name="chart_template_id" ref="ci_fcp_chart_template"/>
        </record>

        <!-- Classe 6: Comptes de Charges -->
        <record id="ci_fcp_class6" model="account.account.template">
            <field name="name">COMPTES DE CHARGES</field>
            <field name="code">6</field>
            <field name="account_type">expense</field>
            <field name="chart_template_id" ref="ci_fcp_chart_template"/>
        </record>

        <!-- Classe 7: Comptes de Produits -->
        <record id="ci_fcp_class7" model="account.account.template">
            <field name="name">COMPTES DE PRODUITS</field>
            <field name="code">7</field>
            <field name="account_type">income</field>
            <field name="chart_template_id" ref="ci_fcp_chart_template"/>
        </record>

        <!-- Classe 8: Comptes de Résultats -->
        <record id="ci_fcp_class8" model="account.account.template">
            <field name="name">COMPTES DE RESULTATS</field>
            <field name="code">8</field>
            <field name="account_type">equity</field>
            <field name="chart_template_id" ref="ci_fcp_chart_template"/>
        </record>

    </data>
</odoo>

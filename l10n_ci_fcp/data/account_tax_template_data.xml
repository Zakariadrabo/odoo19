        <!-- TVA 18% sur Achats -->
        <record id="ci_fcp_tax_tva_achat_18" model="account.tax.template">
            <field name="name">TVA 18% Achat</field>
            <field name="description">TVA 18% A</field>
            <field name="amount">18.0</field>
            <field name="amount_type">percent</field>
            <field name="type_tax_use">purchase</field>
            <field name="chart_template_id" ref="ci_fcp_chart_template"/>
            <field name="invoice_repartition_line_ids" eval="[(5, 0, 0),
                (0,0, {
                    'factor_percent': 100,
                    'repartition_type': 'base',
                }),
                (0,0, {
                    'factor_percent': 100,
                    'repartition_type': 'tax',
                    'account_id': ref('ci_fcp_355200'),
                }),
            ]"/>
            <field name="refund_repartition_line_ids" eval="[(5, 0, 0),
                (0,0, {
                    'factor_percent': 100,

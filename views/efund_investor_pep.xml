<odoo>
    <record id="view_efund_pep_list" model="ir.ui.view">
        <field name="name">efund.investor.pep.list</field>
        <field name="model">efund.investor.pep</field>
        <field name="arch" type="xml">
            <list string="PEP">
                <field name="full_name" readonly="1"/>
                <field name="nom"/>
                <field name="prenom"/>
                <field name="country_id"/>
                <field name="fonction"/>
            </list>
        </field>
    </record>


    <record id="view_efund_pep_form" model="ir.ui.view">
        <field name="name">efund.investor.pep.form</field>
        <field name="model">efund.investor.pep</field>
        <field name="arch" type="xml">
            <form string="Personne Politiquement Exposée">
                <sheet>

                    <group>
                        <field name="full_name"/>
                        <field name="nom"/>
                        <field name="prenom"/>
                        <field name="country_id"/>
                        <field name="fonction"/>
                    </group>
                </sheet>

                <chatter>
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </chatter>
            </form>
        </field>
    </record>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>

<record id="view_efund_investor_heir_form" model="ir.ui.view">
    <field name="name">efund.investor.heir.form</field>
    <field name="model">efund.investor.heir</field>
    <field name="arch" type="xml">
        <form string="Héritier / Ayant droit">
            <sheet>
                <group col="4">
                    <field name="full_name_heir"/>
                    <field name="birthdate"/>
                    <field name="birthplace"/>
                    <field name="birth_country_id"/>
                </group>

                <group>
                    <field name="sex"/>
                    <field name="relationship"/>
                    <field name="email"/>
                    <field name="phone"/>
                </group>
            </sheet>
        </form>
    </field>
</record>
</odoo>
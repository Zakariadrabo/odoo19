<odoo>
    <record id="view_efund_investor_subscription_tree_enhanced" model="ir.ui.view">
        <field name="name">efund.investor.subscription.tree.enhanced</field>
        <field name="model">efund.investor.subscription</field>
        <field name="arch" type="xml">
            <list string="Souscriptions" decoration-danger="state == 'cancelled'"
                  decoration-success="state == 'accounted'">
                <field name="name" string="Référence"/>
                <field name="investor_id"/>
                <field name="fund_id"/>
                <field name="share_class_id" invisible="1"/>
                <field name="date_operation" widget="datetime"/>
                <field name="nav" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="gross_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="net_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="shares" widget="number"/>
                <field name="amount_remaining" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="date_valeur" widget="datetime"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_efund_investor_subscription_form_enhanced" model="ir.ui.view">
        <field name="name">efund.investor.subscription.form.enhanced</field>
        <field name="model">efund.investor.subscription</field>
        <field name="arch" type="xml">
            <form string="Souscription">
                <header>
                    <button name="action_submit_subscription"
                            type="object"
                            string="Soumettre"
                            class="btn-primary"
                            icon="fa-paper-plane-o"
                            title="Soumettre la souscription pour validation"
                           invisible="state != 'draft'"/>

                    <button name="action_validate_subscription"
                            type="object"
                            string="Valider"
                            class="btn-success"
                            icon="fa-check"
                            title="Valider la souscription"
                            invisible="state != 'submitted'"/>

                    <button name="action_account"
                            type="object"
                            string="Comptabiliser"
                            class="btn-warning oe_highlight"
                            icon="fa-calculator"
                            title="Comptabiliser la souscription"
                            invisible="state != 'validated'"/>

                    <button name="action_cancel_subscription"
                            type="object"
                            string="Annuler"
                            class="btn-danger"
                            icon="fa-times"
                            title="Annuler la souscription"
                            invisible="state in ['accounted', 'cancelled','reconciled']"/>

                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,validated,accounted,cancelled"
                           statusbar_colors='{"cancelled": "red"}'/>
                </header>

                <sheet>
                    <!-- Header avec informations clés -->
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" title="Montant brut de la souscription">
                            <div class="fa fa-money fa-2x" title="Argent"/>
                            <div class="o_stat_info">
                                <span class="o_stat_text">Montant brut</span>
                                <span class="o_stat_value">
                                    <field name="gross_amount" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           readonly="state != 'draft'"/>
                                </span>
                            </div>
                        </button>

                        <button class="oe_stat_button" type="object" title="Nombre de parts à souscrire">
                            <div class="fa fa-pie-chart fa-2x" title="Parts"/>
                            <div class="o_stat_info">
                                <span class="o_stat_text">Parts</span>
                                <span class="o_stat_value">
                                    <field name="shares" widget="number"
                                           options="{'digits': [16,4]}"/>
                                </span>
                            </div>
                        </button>

                        <button class="oe_stat_button" type="object" title="Frais de souscription">
                            <div class="fa fa-percent fa-2x" title="Pourcentage"/>
                            <div class="o_stat_info">
                                <span class="o_stat_text">Frais</span>
                                <span class="o_stat_value">
                                    <field name="subscription_fee_rate" widget="percentage" readonly="1"/>
                                    <span class="text-muted">(<field name="subscription_fee_amount" widget="monetary"
                                                                     options="{'currency_field': 'currency_id'}"
                                                                     readonly="1"/>)
                                    </span>
                                </span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label class="oe_edit_only" for="name" string="Référence"/>
                        <h1>
                            <field name="name" placeholder="Référence de la souscription"/>
                        </h1>
                        <h2>
                            <span class="text-muted"> Investisseur : </span>
                            <field name="investor_id" readonly="1" title="Investisseur"/>
                            <span class="text-muted"> → Fond : </span>
                            <field name="fund_id"  readonly="1" title="Fonds"/>
                        </h2>
                    </div>

                    <!-- Informations principales -->
                    <group string="Informations principales">
                        <group>
                            <group>
                                <field name="date_operation" widget="datetime" string="Date opération"/>
                                <field name="date_valeur" widget="datetime" string="Date valeur"/>
                            </group>
                            <group>
                                <field name="share_class_id" widget="selection" string="Classe de parts"
                                       readonly="state != 'draft'"/>
                                <field name="allow_fractional_parts" string="Parts fractionnées" readonly="1"/>

                            </group>
                        </group>
                    </group>

                    <!-- Paramètres de souscription -->
                    <group string="Paramètres de souscription">
                        <group>
                            <group>
                                <field name="buy_choice" widget="radio" string="Mode d'achat" required="1"/>
                                 <field name="is_subscription_fee" string="Appliquer frais"/>
                            </group>
                            <group>
                                <div class="alert alert-info" role="alert">
                                    <strong>NAV:</strong>
                                    <field name="nav" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           class="text-danger font-weight-bold" readonly="1"/>
                                    <br/>
                                    <small class="text-muted">Valeur liquidative actuelle</small>
                                </div>
                            </group>
                        </group>
                    </group>

                    <!-- Calcul des montants -->
                    <group string="Calcul des montants">
                        <group col="3">
                            <!-- Colonne gauche : Entrées -->
                            <group string="Entrées">
                                <field name="gross_amount" widget="monetary" options="{'currency_field': 'currency_id', 'digits': [16,2]}"
                                       required="buy_choice == 'amount'" readonly="buy_choice != 'amount'" string="Montant brut"/>
                                <field name="shares" widget="monetary" options="{'currency_field': 'currency_id', 'digits': [16,2]}" required="buy_choice == 'share'" readonly="buy_choice != 'share'" string="Nombre de parts"/>
                            </group>

                            <!-- Colonne droite : Résultats -->
                            <group string="Résultats calculés">
                                    <field name="net_amount" widget="monetary" options="{'currency_field': 'currency_id'}" class="font-weight-bold text-success" readonly="1"/>
                                    <field name="subscription_fee_amount" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                                    <field name="amount_remaining" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                            </group>
                        </group>
                    </group>

                    <!-- Comptes associés -->
                    <group>
                        <group col="2">
                            <group string="Compte Espèces">
                                <field name="cash_account_id" readonly="1"/>
                                <div class="o_row">
                                    <!-- <label>Solde disponible:</label> -->
                                    <field name="balance" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           class="font-weight-bold" readonly="1"/>
                                </div>
                            </group>
                            <group string="Compte Titre">
                                <field name="part_account_id" readonly="1"/>
                                <div class="o_row">
                                    <label class="oe_edit_only" for="total_shares" string="Total parts actuelles:"/>
                                    <field name="total_shares" widget="number" class="font-weight-bold" readonly="1"/>
                                </div>
                            </group>
                        </group>
                    </group>

                    <!-- Aperçu du calcul -->
                    <div class="alert alert-warning" role="alert">
                        <h4 class="alert-heading">
                            <i class="fa fa-calculator" title="Calculatrice"/>
                            Aperçu du calcul
                        </h4>
                        <hr/>
                        <div class="row">
                            <div class="col-4">
                                <strong>Montant brut:</strong>
                                <br/>
                                <field name="gross_amount" widget="monetary"
                                       options="{'currency_field': 'currency_id'}"
                                       readonly="1"/>
                            </div>
                            <div class="col-4">
                                <strong>Frais (<field name="subscription_fee_rate"/>%):
                                </strong>
                                <br/>
                                <field name="subscription_fee_amount" widget="monetary"
                                       options="{'currency_field': 'currency_id'}"
                                       readonly="1"/>
                            </div>
                            <div class="col-4">
                                <strong>Reliquat : </strong>
                                <br/>
                                <field name="amount_remaining" widget="monetary"
                                       options="{'currency_field': 'currency_id'}"
                                       readonly="1"/>
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-4">
                                <strong>Montant net:</strong>
                                <br/>
                                <field name="net_amount" widget="monetary"
                                       options="{'currency_field': 'currency_id'}"
                                       class="font-weight-bold text-success" readonly="1"/>
                            </div>
                            <div class="col-4">
                                <strong>Parts acquises:</strong>
                                <br/>
                                <field name="shares" widget="number" class="font-weight-bold text-primary" readonly="1"/>
                            </div>
                        </div>
                    </div>

                    <!-- Informations de comptabilisation (visible seulement après comptabilisation) -->
                    <group string="Mouvements comptables" invisible="state not in ['accounted', 'reconciled']">
                        <div class="alert alert-success" role="alert">
                            <h4 class="alert-heading">
                                <i class="fa fa-check-circle" title="Succès"/>
                                Souscription comptabilisée
                            </h4>
                            <p>La souscription a été comptabilisée avec succès le<field name="date_valeur"
                                                                                        widget="datetime" readonly="1"/>
                                .
                            </p>
                            <hr/>
                            <div class="row">
                                <div class="col-4">
                                    <strong>Mouvement investisseur:</strong>
                                    <br/>
                                    <field name="investor_cash_move_id" readonly="1"/>
                                </div>
                                <div class="col-4">
                                    <strong>Mouvement fond:</strong>
                                    <br/>
                                    <field name="fund_cash_move_id" readonly="1"/>
                                </div>
                                <div class="col-4">
                                    <strong>Frais:</strong>
                                    <br/>
                                    <field name="operation_fee_move_id" readonly="1"/>
                                </div>
                            </div>
                        </div>

                        <!-- Timeline des opérations -->
                        <div class="o_timeline">
                            <div class="o_timeline_item">
                                <div class="o_timeline_left">
                                    <span class="o_timeline_marker bg-success">
                                        <i class="fa fa-check" title="Validation"></i>
                                    </span>
                                </div>
                                <div class="o_timeline_right">
                                    <strong>Souscription validée</strong>
                                    <small class="text-muted">
                                        <field name="date_valeur" widget="datetime" readonly="1"/>
                                    </small>
                                </div>
                            </div>

                            <div class="o_timeline_item" invisible="not investor_cash_move_id">
                                <div class="o_timeline_left">
                                    <span class="o_timeline_marker bg-success">
                                        <i class="fa fa-money" title="Argent"></i>
                                    </span>
                                </div>
                                <div class="o_timeline_right">
                                    <strong>Compte investisseur débité</strong>
                                    <small class="text-muted">Montant:
                                        <field name="net_amount" widget="monetary"
                                               options="{'currency_field': 'currency_id'}"
                                               readonly="1"/>
                                    </small>
                                </div>
                            </div>

                            <div class="o_timeline_item" invisible="not fund_cash_move_id">
                                <div class="o_timeline_left">
                                    <span class="o_timeline_marker bg-success">
                                        <i class="fa fa-bank" title="Banque"></i>
                                    </span>
                                </div>
                                <div class="o_timeline_right">
                                    <strong>Compte fond crédité</strong>
                                    <small class="text-muted">Montant:
                                        <field name="net_amount" widget="monetary"
                                               options="{'currency_field': 'currency_id'}"
                                               readonly="1"/>
                                    </small>
                                </div>
                            </div>

                            <div class="o_timeline_item" invisible="not operation_fee_move_id">
                                <div class="o_timeline_left">
                                    <span class="o_timeline_marker bg-success">
                                        <i class="fa fa-percent" title="Pourcentage"></i>
                                    </span>
                                </div>
                                <div class="o_timeline_right">
                                    <strong>Frais enregistrés</strong>
                                    <small class="text-muted">Montant:
                                        <field name="subscription_fee_amount" widget="monetary"
                                               options="{'currency_field': 'currency_id'}"
                                               readonly="1"/>
                                    </small>
                                </div>
                            </div>
                        </div>
                    </group>
                </sheet>

                <!-- Chatter -->
                <chatter>
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </chatter>
            </form>
        </field>
    </record>
</odoo>
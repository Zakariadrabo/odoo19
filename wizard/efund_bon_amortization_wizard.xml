<odoo>
    <record id="view_efund_bond_amortization_wizard_form" model="ir.ui.view">
        <field name="name">efund.bond.amortization.wizard.form</field>
        <field name="model">efund.bond.amortization.wizard</field>
        <field name="arch" type="xml">
            <form string="Générer Tableau d'Amortissement">
                <sheet>
                    <group>
                        <group>
                            <field name="instrument_id"/>
                            <field name="nominal_amount"/>
                            <field name="coupon_rate"/>
                            <field name="maturity_years"/>
                            <field name="amortization_type"/>
                        </group>
                        <group>
                            <field name="frequency"/>
                            <field name="start_date"/>
                            <field name="grace_period" invisible="amortization_type not in ('in_fine')"/>
                            <field name="balloon_percentage" invisible="amortization_type != 'american'"/>
                        </group>
                    </group>

                    <!-- Section pour l'échéancier personnalisé
                    <group invisible="amortization_type !=  'custom_schedule'">
                        <field name="custom_schedule_line_ids"
                               context="{'default_wizard_id': active_id}">
                            <tree editable="bottom" string="Échéancier Personnalisé">
                                <field name="period_number" string="Période" required="1"/>
                                <field name="fixed_principal_amount" string="Montant Fixe"/>
                                <field name="percentage_principal" string="Pourcentage (%)"/>
                            </tree>
                        </field>
                    </group>
                    -->
                </sheet>
                <footer>
                    <button name="action_generate_schedule" string="Générer" type="object"
                            class="btn-primary"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

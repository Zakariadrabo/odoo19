<odoo>

    <record id="view_instrument_valuation_simulation_form"
            model="ir.ui.view">
        <field name="name">efund.instrument.valuation.simulation.form</field>
        <field name="model">efund.instrument.valuation.simulation.wizard</field>
        <field name="arch" type="xml">
            <form string="Simulation de valorisation">
                <sheet>

                    <group>
                        <field name="instrument_id"/>
                        <field name="valuation_date"/>
                    </group>

                    <separator string="Résultat de la simulation"/>

                    <group>
                        <field name="actuarial_value" readonly="1"/>
                        <field name="linear_value" readonly="1"/>
                        <field name="effective_value" readonly="1"/>
                    </group>

                    <footer>
                        <button string="Fermer"
                                class="btn-secondary"
                                special="cancel"/>
                    </footer>

                </sheet>
            </form>
        </field>
    </record>

</odoo>

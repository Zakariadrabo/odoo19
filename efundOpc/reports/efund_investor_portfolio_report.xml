<odoo>

  <!-- TEMPLATE QWEB -->
  <template id="efund_investor_portfolio_report">
    <t t-call="web.external_layout">
      <t t-set="docs" t-value="docs"/>
      <main class="page">
        <h2>État du portefeuille investisseur</h2>

        <p>
          <strong>Investisseur :</strong>
          <t t-esc="docs.investor_id.name"/>
        </p>

        <table class="table table-sm table-bordered">
          <thead>
            <tr>
              <th>Fonds</th>
              <th>Parts</th>
              <th>CMP</th>
              <th>VL</th>
              <th>Coût d’acquisition</th>
              <th>Solde Cash</th>
              <th>Valorisation</th>
              <th>Gain / Perte</th>
            </tr>
          </thead>
          <tbody>
            <t t-foreach="lines" t-as="l">
              <tr>
                <td><t t-esc="l['fund_name']"/></td>
                <td class="text-end"><t t-esc="l['parts']"/></td>
                <td class="text-end"><t t-esc="l['cmp']"/></td>
                <td class="text-end"><t t-esc="l['nav']"/></td>
                <td class="text-end"><t t-esc="l['acquisition_cost']"/></td>
                <td class="text-end"><t t-esc="l['cash_balance']"/></td>
                <td class="text-end"><t t-esc="l['valuation']"/></td>
                <td class="text-end"><t t-esc="l['gain']"/></td>
              </tr>
            </t>
          </tbody>
        </table>

        <p class="mt16">
          <em>Les performances passées ne préjugent pas des performances futures.</em>
        </p>
      </main>
    </t>
  </template>

  <!-- ACTION REPORT -->


</odoo>

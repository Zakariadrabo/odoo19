<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="efund_kyc_investor_report_pdf" model="ir.actions.report">
        <field name="name">KYC Investor Report</field>
        <field name="model">efund.investor</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">efund.efund_kyc_report_template</field>
        <field name="report_file">efund.efund_kyc_report_template</field>
        <field name="binding_model_id" ref="model_efund_investor"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'KYC - %s' % (object.full_name or object.partner_id.name)</field>
    </record>

    <record id="action_efund_investor_portfolio_report" model="ir.actions.report">
        <field name="name">Portefeuille Investisseur</field>
        <field name="model">efund.investor.portfolio.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">efundOpc.efund_investor_portfolio_report</field>
        <field name="report_file">efundOpc.efund_investor_portfolio_report</field>
        <field name="print_report_name">'Portefeuille investisseur - %s' % (object.investor_id.name or object.investor_id.partner_id.name)</field>
    </record>


</odoo>
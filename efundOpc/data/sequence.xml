<odoo>
    <!-- Sequence for fund redemption orders -->
    <record id="seq_efund_fund_redemption" model="ir.sequence">
        <field name="name">Ordre de rachat OPCVM</field>
        <field name="code">efund.investor.redemption</field>
        <field name="prefix">RED/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <!-- Sequence for cash operation -->
    <record id="seq_efund_investor_cash_operation" model="ir.sequence">
        <field name="name">Mouvement cash investisseurs</field>
        <field name="code">efund.investor.cash.operation</field>
        <field name="prefix">CSH/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Sequence for véhicule -->
    <record id="seq_efund_vehicule" model="ir.sequence">
        <field name="name">Mouvement véhicule</field>
        <field name="code">efund.vehicule</field>
        <field name="prefix">VEH/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Séquence for efund.nav.session' -->
    <record id="seq_efund_nav_session" model="ir.sequence">
        <field name="name">Nav Session</field>
        <field name="code">efund.nav.session</field>
        <field name="prefix">VL/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Sequence for fund cash movements -->
    <record id="seq_efund_fund_cash_move" model="ir.sequence">
        <field name="name">Mouvement espèces fonds</field>
        <field name="code">efund.fund.cash.move</field>
        <field name="prefix">FCM/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Sequence for investor cash movements -->
    <record id="seq_efund_investor_cash_move" model="ir.sequence">
        <field name="name">Mouvement espèces investisseurs</field>
        <field name="code">efund.investor.cash.move</field>
        <field name="prefix">ICM/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Sequence for investor share movements -->
    <record id="seq_efund_investor_cash_move" model="ir.sequence">
        <field name="name">Mouvement espèces investisseurs</field>
        <field name="code">efund.investor.part.move</field>
        <field name="prefix">IPM/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

     <!-- Sequence for deposite -->
    <record id="seq_efund_investor_deposit" model="ir.sequence">
        <field name="name">Sequence pour le déposit</field>
        <field name="code">efund.investor.deposit</field>
        <field name="prefix">DEP/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <!-- Sequence for withdraw -->
    <record id="seq_efund_investor_withdraw" model="ir.sequence">
        <field name="name">Sequence pour le retrait</field>
        <field name="code">efund.investor.withdraw</field>
        <field name="prefix">WDR/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <!-- Sequence for subscription -->
    <record id="seq_efund_investor_subscription" model="ir.sequence">
        <field name="name">Sequence pour la souscription</field>
        <field name="code">efund.investor.subscription</field>
        <field name="prefix">SUB/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <!-- Sequence for redemption -->
    <record id="seq_efund_investor_redemption" model="ir.sequence">
        <field name="name">Sequence pour la retrait</field>
        <field name="code">efund.investor.redemption</field>
        <field name="prefix">RED/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Sequence for investor fee -->
    <record id="seq_efund_investor_operation_fee" model="ir.sequence">
        <field name="name">Sequence pour les frais investisseurs</field>
        <field name="code">efund.investor.operation.fee</field>
        <field name="prefix">FEE/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

     <!-- Sequence for fund log reconciliation -->
    <record id="seq_efund_opration_reconciliation_log" model="ir.sequence">
        <field name="name">Séquence Log de Réconciliation</field>
        <field name="code">efund.opration.reconciliation.log</field>
        <field name="prefix">log_op/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

     <!-- Sequence for broker order -->
    <record id="seq_efund_bourse_order" model="ir.sequence">
        <field name="name">Séquence pour les ordres de courtier</field>
        <field name="code">efund.bourse.order</field>
        <field name="prefix">ORD/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

     <!-- Sequence for broker order -->
    <record id="seq_efund_bourse_order" model="ir.sequence">
        <field name="name">Séquence pour les ordres de courtier</field>
        <field name="code">efund.investment.order</field>
        <field name="prefix">ORD/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Sequence for broker order -->
    <record id="seq_efund_bourse_order_execution_line" model="ir.sequence">
        <field name="name">Séquence pour les transactions</field>
        <field name="code">efund.bourse.order.execution.line</field>
        <field name="prefix">TRANS/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <!-- Cash Move -->
    <record id="seq_efund_investor_cash_account_move" model="ir.sequence">
        <field name="name">Séquence pour les mouvements cash véhicule</field>
        <field name="code">efund.investor.cash_account.move</field>
        <field name="prefix">MVT/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_efund_fund_instrument_fee" model="ir.sequence">
        <field name="name">Séquence pour les frais des instruments</field>
        <field name="code">efund.fund.instrument.fee</field>
        <field name="prefix">FEE/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_efund_vehicule_mandate" model="ir.sequence">
        <field name="name">Séquence pour les mandats</field>
        <field name="code">efund.vehicule.mandate</field>
        <field name="prefix">MDT</field>
        <field name="padding">2</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_efund_vehicule_cash_move" model="ir.sequence">
        <field name="name">Séquence pour les mouvements cash véhicule</field>
        <field name="code">efund.vehicule.cash.move</field>
        <field name="prefix">MVT/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_efund_investment_transaction" model="ir.sequence">
        <field name="name">Séquence pour les transactions</field>
        <field name="code">efund.investment.transaction</field>
        <field name="prefix">MVT/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_efund_vehicule_instrument_fee" model="ir.sequence">
        <field name="name">Séquence pour les frais</field>
        <field name="code">efund.vehicule.instrument.fee</field>
        <field name="prefix">FEE/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>

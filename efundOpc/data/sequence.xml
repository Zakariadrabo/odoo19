<odoo>
    <!-- Sequence for fund redemption orders -->
    <record id="seq_efund_fund_redemption" model="ir.sequence">
        <field name="name">Ordre de rachat OPCVM</field>
        <field name="code">efund.investor.redemption</field>
        <field name="prefix">RED/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Sequence for fund cash movements -->
    <record id="seq_efund_fund_cash_move" model="ir.sequence">
        <field name="name">Mouvement espèces fonds</field>
        <field name="code">efund.fund.cash.move</field>
        <field name="prefix">FCM/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Sequence for investor cash movements -->
    <record id="seq_efund_investor_cash_move" model="ir.sequence">
        <field name="name">Mouvement espèces investisseurs</field>
        <field name="code">efund.investor.cash.move</field>
        <field name="prefix">ICM/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

     <!-- Sequence for deposite -->
    <record id="seq_efund_investor_deposit" model="ir.sequence">
        <field name="name">Sequence pour le déposit</field>
        <field name="code">efund.investor.deposit</field>
        <field name="prefix">DEP/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <!-- Sequence for deposite -->
    <record id="seq_efund_investor_withdraw" model="ir.sequence">
        <field name="name">Sequence pour le retrait</field>
        <field name="code">efund.investor.withdraw</field>
        <field name="prefix">WDR/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <!-- Sequence for deposite -->
    <record id="seq_efund_investor_subscription" model="ir.sequence">
        <field name="name">Sequence pour la souscription</field>
        <field name="code">efund.investor.subscription</field>
        <field name="prefix">SUB/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <!-- Sequence for deposite -->
    <record id="seq_efund_investor_redemption" model="ir.sequence">
        <field name="name">Sequence pour la retrait</field>
        <field name="code">efund.investor.redemption</field>
        <field name="prefix">RED/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
     <!-- Sequence for fund log reconciliation -->
    <record id="seq_efund_opration_reconciliation_log" model="ir.sequence">
        <field name="name">Séquence Log de Réconciliation</field>
        <field name="code">efund.opration.reconciliation.log</field>
        <field name="prefix">log_op/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>


</odoo>

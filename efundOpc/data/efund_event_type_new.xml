            <field name="name">Action. Vente - Encaissement</field>
            <field name="code">EQUITITY_SOLD_PAIEMENT</field>
            <field name="state">validated</field>
        </record>

        <record id="event_type_014" model="efund.event.type">
            <field name="name">BON. Souscription</field>
            <field name="code">TCN_SUBSCRIPTION</field>
            <field name="state">validated</field>
        </record>
        <record id="event_type_015" model="efund.event.type">
            <field name="name">TCN. Achat. Dénouement</field>
            <field name="code">TCN_TRADE_SETTLE</field>

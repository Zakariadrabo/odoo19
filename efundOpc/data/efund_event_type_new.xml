            <field name="name">DAT. Fin</field>
            <field name="code">DAT_EXECUTED_OUT</field>
            <field name="state">validated</field>
        </record>

        <!-- Investissement sur les part d'OPCVM -->
        <record id="event_type_023" model="efund.event.type">
            <field name="name">OPC. Souscription Titre</field>
            <field name="code">OPC_EXECUTED_IN</field>
            <field name="state">validated</field>
        </record>
        <record id="event_type_024" model="efund.event.type">
            <field name="name">OPC. Rachat Titre</field>
            <field name="code">OPC_EXECUTED_OUT</field>
            <field name="state">validated</field>
        </record>

        <!-- Souscription rachat de part d'opc par les clients -->
        <record id="event_type_025" model="efund.event.type">
            <field name="name">OPC - Souscription Client Cash</field>
            <field name="code">SUBS_VALIDATED_CASH</field>
            <field name="state">validated</field>
        </record>
        <record id="event_type_026" model="efund.event.type">
            <field name="name">OPC - Souscription Client Par Titre</field>
            <field name="code">SUBS_VALIDATED_TITRE</field>

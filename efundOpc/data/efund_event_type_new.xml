<odoo>
    <data>
        <record id="event_type_001" model="efund.event.type">
            <field name="name">OBL. Souscription</field>
            <field name="code">TRADE_SUBSCRIPTION_IN</field>
            <field name="state">validated</field>
        </record>
        <record id="event_type_002" model="efund.event.type">
            <field name="name">OBL. Achat. Execution</field>
            <field name="code">TRADE_EXECUTED_IN</field>

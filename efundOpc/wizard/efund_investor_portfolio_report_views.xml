<odoo>
  <record id="view_investor_portfolio_report_wizard" model="ir.ui.view">
    <field name="name">investor.portfolio.report.wizard.form</field>
    <field name="model">efund.investor.portfolio.report.wizard</field>
    <field name="arch" type="xml">
      <form string="État du portefeuille investisseur">
        <group>
          <field name="investor_id"/>
        </group>
        <footer>
          <button string="Imprimer"
                  type="object"
                  name="action_print_report"
                  class="btn-primary"/>
          <button string="Annuler" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>

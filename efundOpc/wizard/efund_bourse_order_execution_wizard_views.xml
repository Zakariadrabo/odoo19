<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_efund_bourse_order_execution_wizard_form"
            model="ir.ui.view">
        <field name="name">efund.bourse.order.execution.wizard.form</field>
        <field name="model">efund.bourse.order.execution.wizard</field>
        <field name="arch" type="xml">
            <form string="Exécution de l’ordre">
                <group>
                    <field name="order_id"/>
                    <field name="reference"/>
                    <field name="remaining_quantity" invisible="operation_type not in ('trade','opcvm')"/>
                    <field name="operation_type" invisible="1"/>
                    <field name="instrument_type" invisible="1"/>
                </group>

                <group string="Détails d'exécution" invisible="operation_type not in ('trade','opcvm') or instrument_type =='tcn'">
                    <field name="executed_quantity" required="1"/>
                    <field name="execution_price" required="1"/>
                    <field name="execution_date" required="1"/>
                </group>
                <group string="Détails d'exécution" invisible="operation_type != 'trade' or instrument_type !='tcn'">
                        <group string="Détails de la Négociation" class="oe_edit_only"
                               style="background-color: #f8f9fa; padding: 10px; border-radius: 5px;">
                            <field name="calculation_type" widget="radio" options="{'horizontal': true}" string="Choix du rendement"/>
                            <field name="execution_date" required="1"/>
                            <field name="executed_quantity"/>
                            <field name="yield_rate" readonly="calculation_type != 'rate'" force_save="1"  class="oe_inline" string="Rendement %"/>
                            <field name="purchase_price" readonly="calculation_type != 'amount'" widget="monetary" class="fw-bold text-primary" string="Prix d'acquisition Nominal" force_save="1"/>
                            <field name="discount_amount" readonly="1" force_save="1" string="rendement Prix / Bon"/>
                        </group>

                        <group string="Résumé">

                            <field name="total_amount_trade" widget="monetary" class="fw-bold text-primary"
                                   string="Montant Transaction" force_save="1"/>
                            <field name="total_interest" readonly="1" string="Intérêt Précompté"/>
                            <field name="total_courtage" readonly="1" widget="monetary" class="fw-bold text-primary"
                                   string="Montant Courtage" force_save="1"/>
                            <field name="total_tva" readonly="1" widget="monetary" class="fw-bold text-primary"
                                   string="Montant TVA" force_save="1"/>
                            <field name="total_amount" string="Montant à récevoir"/>
                        </group>
                    </group>
                <group string="Conditions du DAT" invisible="operation_type != 'deposit'">
                    <group>
                        <field name="deposit_amount" widget="monetary"/>
                        <field name="negotiated_rate" widget="float"/>
                        <field name="interest_type"/>
                        <field name="negotiated_rate_net" />
                        <field name="start_date"/>
                        <field name="maturity_date"/>
                    </group>
                    <group>
                        <field name="total_interet_brut"/>
                        <field name="total_irvm"/>
                        <field name="total_interest"/>
                        <field name="total_amount"/>
                    </group>
                </group>
                <group string="Détails de l'Ordre OPCVM" invisible="operation_type != 'opcvm'">
                        <div class="alert alert-info" role="alert" colspan="2" style="margin-bottom:10px;">
                            <i class="fa fa-info-circle"/>
                            Exécution à Valeur Liquidative connue.
                        </div>
                        <group>
                            <field name="amount_type" widget="radio" options="{'horizontal': true}"/>
                            <field name="order_amount" widget="monetary" string="Montant Brut"
                                   readonly="amount_type == 'unit'" force_save="1"/>
                            <field name="nav" string="Valeur liquidative"/>
                             <field name="nav_date_expected"/>
                            <field name="units_estimated" class="text-muted" readonly="amount_type == 'amount'" force_save="1"/>
                        </group>
                        <group>
                           <field name="total_amount_trade" readonly="1"/>
                            <field name="total_amount" readonly="1"/>
                        </group>

                    </group>
                <div class="row">
                    <div class="o_form_label text-info">
                        <field name="formulas_accured_interest" readonly="1"/>
                    </div>
                </div>

                <div class="border rounded p-3" invisible="instrument_type =='tcn'">
                    <div class="row" invisible="operation_type not in ('deposit','trade')">
                        <div class="col-4">
                            <strong>Intérêt couru brut</strong>
                            <br/>
                            <field name="total_interet_brut" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   readonly="1"/>
                        </div>
                        <div class="col-4">
                            <strong>IRVM / IRCM</strong>
                            <br/>
                            <field name="total_irvm" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   readonly="1"/>
                        </div>
                        <div class="col-4">
                            <strong>Intérêt couru net</strong>
                            <br/>
                            <field name="total_interest" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   readonly="1"/>
                        </div>
                    </div>
                    <hr/>
                    <div class="row" invisible="operation_type not in ('trade')">
                        <div class="col-4">
                            <strong>Commission Bourse:</strong>
                            <br/>
                            <field name="total_bvm" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   readonly="1"/>
                        </div>
                        <div class="col-4">
                            <strong>Commission Dépositaire Central:
                            </strong>
                            <br/>
                            <field name="total_dc" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   readonly="1"/>
                        </div>
                        <div class="col-4">
                            <strong>Commission Régulateur :</strong>
                            <br/>
                            <field name="total_regulateur" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   readonly="1"/>
                        </div>
                    </div>
                    <hr/>
                    <div class="row" invisible="operation_type not in ('trade')">
                        <div class="col-6">
                            <strong>Frais de Courtage:</strong>
                            <br/>
                            <field name="total_courtage" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   readonly="1"/>
                        </div>
                        <div class="col-6">
                            <strong>TVA:
                            </strong>
                            <br/>
                            <field name="total_tva" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   readonly="1"/>
                        </div>
                    </div>
                    <hr/>
                    <div class="row">
                        <div class="col-4">
                            <strong>Total Transaction :</strong>
                            <br/>
                            <field name="total_amount_trade" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   readonly="1"/>
                        </div>
                        <div class="col-4">
                            <strong>Total Commissions &amp; Taxes:
                            </strong>
                            <br/>
                            <field name="free_tax_amount" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   readonly="1"/>
                        </div>
                        <div class="col-4">
                            <strong>Total TTC :</strong>
                            <br/>
                            <field name="total_amount" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   readonly="1"/>
                        </div>
                    </div>

                </div>

                <footer>
                    <button name="action_confirm_execution"
                            string="Valider l’exécution"
                            type="object"
                            class="btn-primary"/>
                    <button string="Annuler"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>

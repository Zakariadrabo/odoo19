<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_efund_bourse_order_execution_wizard_form"
            model="ir.ui.view">
        <field name="name">efund.bourse.order.execution.wizard.form</field>
        <field name="model">efund.bourse.order.execution.wizard</field>
        <field name="arch" type="xml">
            <form string="Exécution de l’ordre">
                <group>
                    <field name="order_id"/>
                    <field name="reference"/>
                    <field name="remaining_quantity"/>
                </group>

                <group string="Détails d'exécution">
                    <field name="executed_quantity" required="1"/>
                    <field name="execution_price" required="1"/>
                    <field name="execution_date" required="1"/>
                </group>
                <div class="row">
                     <div class="o_form_label text-info">
                        <field name="formulas_accured_interest" readonly="1"/>
                    </div>
                </div>

                <div class="panel panel-warning">
                    <div class="panel-heading">
                        <i class="fa fa-calculator" title="Calculatrice"/>
                        Résumés
                    </div>
                    <div class="panel-body">
                        <div class="row">
                            <div class="col-4">
                                <strong>Montant brut:</strong>
                                <br/>
                                <field name="free_tax_amount" widget="monetary"
                                       options="{'currency_field': 'currency_id'}"
                                       readonly="1"/>
                            </div>
                            <div class="col-4">
                                <strong>Commission de courtage:
                                </strong>
                                <br/>
                                <field name="total_broker_commission" widget="monetary"
                                       options="{'currency_field': 'currency_id'}"
                                       readonly="1"/>
                            </div>
                            <div class="col-4">
                                <strong>Taxe TVA :</strong>
                                <br/>
                                <field name="total_tob_commission" widget="monetary"
                                       options="{'currency_field': 'currency_id'}"
                                       readonly="1"/>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-4">
                                <strong>Intérêts courus:</strong>
                                <br/>
                                <field name="total_interest" widget="monetary"
                                       options="{'currency_field': 'currency_id'}"
                                       readonly="1"/>
                            </div>
                            <div class="col-4">
                                <strong>Montant Net:
                                </strong>
                                <br/>
                                <field name="total_amount" widget="monetary"
                                       options="{'currency_field': 'currency_id'}"
                                       readonly="1"/>
                            </div>
                        </div>
                    </div>
                </div>

                <footer>
                    <button name="action_confirm_execution"
                            string="Valider l’exécution"
                            type="object"
                            class="btn-primary"/>
                    <button string="Annuler"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>

<odoo>
    <record id="view_join_fund_wizard_form" model="ir.ui.view">
        <field name="name">efund.investor.join.fund.wizard.form</field>
        <field name="model">efund.investor.join.fund.wizard</field>
        <field name="arch" type="xml">
            <form string="Adhésion">
                <group>
                    <field name="investor_id" readonly="1"/>
                    <field name="available_fund_ids" invisible="1"/>
                    <field name="fund_id" options="{'no_create': True}"  domain="[('id', 'in', available_fund_ids)]"/>
                </group>
                <footer>
                    <button name="action_confirm_join" string="Créer les comptes" type="object" class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
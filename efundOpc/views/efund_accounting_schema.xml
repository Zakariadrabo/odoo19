<odoo>
    <record id="view_efund_accounting_schema_form" model="ir.ui.view">
        <field name="name">efund.accounting.schema.form</field>
        <field name="model">efund.accounting.schema</field>
        <field name="arch" type="xml">
            <form string="Schéma Comptable de Fonds">
                <sheet>
                    <div class="oe_title">
                            <group>
                                <field name="name" class="text-primary" string="Nom"/>
                            </group>
                    </div>
                    <group>
                        <group>
                            <field name="journal_code" placeholder="Ex SUB" />
                            <field name="event_type_id" placeholder="Type d'évènement ..."/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Configuration des Lignes" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="account_resolution_type" string="Type de Résolution"/>
                                    <field name="is_off_balance"/>
                                    <field name="account_id" options="{'no_create': True}" invisible="account_resolution_type != 'fixed'" required="account_resolution_type == 'fixed'"/>
                                    <field name="account_selection_type"/>
                                    <field name="side"/>
                                    <field name="use_analytic"/>
                                    <field name="amount_type_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_efund_accounting_schema_tree" model="ir.ui.view">
        <field name="name">efund.accounting.schema.list</field>
        <field name="model">efund.accounting.schema</field>
        <field name="arch" type="xml">
            <list string="Schémas Comptables">
                <field name="name" />
                <field name="event_type_id"/>
                <field name="journal_code"/>
            </list>
        </field>
    </record>
</odoo>
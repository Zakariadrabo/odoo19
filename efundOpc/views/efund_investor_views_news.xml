<odoo>
    <record id="view_efund_investor_form_strict" model="ir.ui.view">
        <field name="name">efund.investor.form.strict</field>
        <field name="model">efund.investor</field>
        <field name="arch" type="xml">
            <form string="Investisseur">
                <header>
                    <button name="action_submit_kyc" type="object" string="Soumettre KYC" class="btn-primary"
                            invisible="status != 'draft'"/>
                    <button name="action_approve_kyc" type="object" string="Approuver" class="btn-success"
                            invisible="status != 'kyc_pending'"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,kyc_pending,approved"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_deposit" type="object" class="oe_stat_button" icon="fa-plus">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Souscriptions</span>
                            </div>
                        </button>
                        <button name="action_open_redemption" type="object" class="oe_stat_button" icon="fa-minus">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Rachats</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <field name="investor_type" widget="radio" options="{'horizontal': true}"/>
                        <h1>
                            <field name="full_name" invisible="investor_type != 'individual'"/>
                            <field name="nom" invisible="investor_type != 'individual'"/>
                            <field name="prenom" invisible="investor_type != 'individual'"/>
                            <field name="company_name" invisible="investor_type != 'company'"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Contact">
                            <field name="partner_id"/>
                            <field name="email"/>
                            <field name="phone"/>
                        </group>
                        <group string="Localisation">
                            <field name="address"/>
                            <!-- <field name="city"/> -->
                            <field name="country_id"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Détails KYC" name="kyc">
                            <group>
                                <group string="Profil Individuel" invisible="investor_type != 'individual'">
                                    <field name="civilite"/>
                                    <field name="birthdate"/>
                                    <field name="birthplace"/>
                                    <field name="nationality"/>
                                    <!-- <field name="occupation"/> -->
                                </group>
                                <group string="Profil Société" invisible="investor_type != 'company'">
                                    <field name="company_short_name" required="investor_type  == 'company'"/>
                                    <field name="legal_form" required="investor_type  == 'company'"/>
                                    <field name="license_number" required="investor_type  == 'company'"/>
                                    <field name="creation_date" required="investor_type  == 'company'"
                                           options="{'numeric': true}"/>
                                </group>
                            </group>
                        </page>

                        <page string="Profil Financier" name="financial">
                            <group>
                                <group string="Objectifs">
                                    <field name="revenu"/>
                                    <field name="origine"/>
                                    <field name="other_origine" required="origine == 'other'"
                                           invisible="origine != 'other'"/>
                                    <field name="objectif"/>
                                    <field name="other_objectif" required="objectif == 'other'"
                                           invisible="objectif != 'other'"/>
                                    <field name="periodicite"/>
                                </group>
                                <group string="Risque">
                                    <field name="market_knowledge"/>
                                    <field name="activity_knowledge"/>
                                    <field name="risk_level_acceptable"/>
                                </group>

                            </group>
                        </page>

                        <page string="Banque" name="bank">
                            <group>
                                <field name="name_bank"/>
                                <field name="bank_address"/>
                                <field name="account_number"/>
                            </group>
                            <group>
                                    <field name="iban"/>
                                    <field name="swift_bic"/>
                                </group>
                        </page>

                        <page string="Représentants &amp; Héritiers" name="relations">
                            <separator string="Héritiers et Contacts"/>
                            <field name="heirs_person_ids">
                                <list editable="bottom">
                                    <field name="type_person"/>
                                    <field name="full_name"/>
                                    <field name="lien_client"/>
                                    <field name="phone"/>
                                </list>
                            </field>

                            <separator string="Représentants Légaux"/>
                            <field name="represented_person_ids">
                                <list editable="bottom">
                                    <field name="full_name"/>
                                    <field name="relationship"/>
                                    <field name="phone"/>
                                    <field name="document_number"/>
                                </list>
                            </field>
                        </page>

                        <page string="Documents &amp; AML" name="compliance">
                            <separator string="Documents KYC"/>
                            <field name="document_ids">
                                <list>
                                    <field name="document_type"/>
                                    <field name="name"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>

                            <separator string="Alertes AML"/>
                            <field name="aml_alert_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="alert_date"/>
                                    <field name="severity" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter>
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </chatter>
            </form>
        </field>
    </record>
</odoo>
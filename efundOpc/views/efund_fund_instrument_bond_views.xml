<!-- views/instrument_bond_views.xml -->
<odoo>
    <record id="view_bond_tree" model="ir.ui.view">
        <field name="name">efund.vehicule.instrument.core.bond.list</field>
        <field name="model">efund.vehicule.instrument.core.bond</field>
        <field name="arch" type="xml">
            <list string="Obligations" decoration-info="next_coupon_date &gt;= context_today()"
                  decoration-warning="maturity_date &lt;= context_today()">
                <!-- Identification -->
                <field name="instrument_id" widget="many2one_clickable"/>
                <field name="isin" string="ISIN"/>
                <field name="currency_id" widget="many2one_clickable"/>

                <!-- Caractéristiques obligataires -->
                <field name="bond_type" string="Type"/>
                <field name="face_value" string="Valeur Nominale"/>
                <field name="coupon_rate" string="Taux Coupon %"/>
                <field name="valuation_method" string="Méthode Valo"/>

                <!-- Dates importantes -->
                <field name="issue_date" string="Émission"/>
                <field name="maturity_date" string="Échéance"/>

                <!-- Calculs dynamiques -->
                <field name="remaining_date_to_maturity" string="Restant Maturité"/>
                <field name="next_coupon_date" string="Prochain Coupon"/>
                <field name="remaining_date_to_coupon" string="Jours Restants Coupon"/>

                <!-- État -->
                <field name="is_listed" string="Coté" invisible="1"/>
                <field name="is_listed" string="Coté" widget="boolean_favorite" column_invisible="1"/>
            </list>
        </field>
    </record>


    <record id="view_bond_form" model="ir.ui.view">
        <field name="name">efund.fund.instrument.bond.form</field>
        <field name="model">efund.fund.instrument.bond</field>
        <field name="arch" type="xml">
            <form string="Caractéristiques Obligation">
                <group string="Paramètres de l'Émission">
                    <group>
                        <field name="bond_type" string="Type d'obligation"/>
                        <field name="issue_amount" string="Montant Émission"/>
                        <field name="face_value" string="Valeur nominale"/>
                        <field name="coupon_rate" string="Taux du coupon (%)" digits="(16,4)"/>
                    </group>
                    <group>
                        <field name="coupon_frequency" string="Fréquence des coupons"/>
                        <field name="issue_date" string="Date émission"/>
                        <field name="value_date" string="Date de jouissance"/>
                        <field name="maturity_date" string="Date de maturité"/>
                    </group>
                </group>

                <group string="Conditions Financières">
                    <group>
                        <field name="purchase_price" string="Prix d'acquisition"/>
                        <field name="yield_rate" string="Rendement actuariel (%)" digits="(16,8)"/>
                        <field name="valuation_method" string="Méthode de valorisation"/>
                        <field name="technical_trick" string="Base de calcul"/>
                    </group>
                    <group>
                        <field name="amortization_type" string="Type d'amortissement"/>
                        <field name="grace_period" string="Période de grâce (années)"/>

                    </group>
                </group>

                <group string="Notation et Risque">
                    <field name="bond_issuer_rating" string="Notation de l'émetteur"/>
                    <field name="rating_agency" string="Agence de notation"/>
                    <field name="state_issuer" string="Émis par État CEMAC"/>
                </group>
            </form>
        </field>
    </record>
</odoo>
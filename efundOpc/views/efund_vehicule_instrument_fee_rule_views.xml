<odoo>
    <record id="view_efund_vehicule_instrument_fee_rule_form" model="ir.ui.view">
        <field name="name">efund.vehicule.instrument.fee.rule.form</field>
        <field name="model">efund.vehicule.instrument.fee.rule</field>
        <field name="arch" type="xml">
            <form string="Règle de Frais sur Transaction">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Nom de la règle"/>
                        <h1>
                            <field name="name" placeholder="Ex: Courtage SGI standard"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Ciblage &amp; Catégorie">
                            <field name="fee_category"/>
                            <field name="is_active" widget="boolean_toggle"/>
                        </group>
                        <group string="Configuration du Calcul">
                            <field name="calculation_method"/>
                            <label for="rate" invisible="calculation_method != 'percentage'"/>
                            <div class="o_row"  invisible="calculation_method != 'percentage'">
                                <field name="rate"/>
                                %%
                            </div>
                            <field name="amount"
                                   widget="monetary"
                                   options="{'currency_field': 'currency_id'}"  invisible="calculation_method != 'fixed'" />
                        </group>
                    </group>
                    <group string="Impact Comptable &amp; PRU">
                        <group>
                            <field name="capitalizable"
                                   help="Si coché, ces frais seront inclus dans le calcul du Coût Moyen Unitaire Pondéré (CMUP)"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
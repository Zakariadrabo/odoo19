<odoo>
    <record id="view_efund_investment_transaction_form" model="ir.ui.view">
        <field name="name">efund.investment.transaction.form</field>
        <field name="model">efund.investment.transaction</field>
        <field name="arch" type="xml">
            <form string="Détails de la Transaction">
                <header>
                    <button name="action_confirm_settlement" string="Valider Règlement/Livraison"
                            type="object" class="btn-success" invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group string="Référence Marché">
                            <field name="order_id" readonly="1"/>
                            <field name="vehicule_id"/>
                            <field name="instrument_id"/>
                            <field name="broker_id"/>
                        </group>
                        <group string="Dates &amp; Quantités">
                            <field name="date_transaction"/>
                            <field name="date_settlement"/>
                            <field name="quantity"/>
                            <field name="price_unit"/>
                        </group>
                    </group>
                    <group string="Décomposition des Frais">
                        <group>
                            <field name="fees_amount"/>
                            <field name="taxes_amount"/>
                        </group>
                        <group>
                            <field name="amount_net" class="oe_subtotal_footer_separator"
                                   style="font-size: 1.5em;"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
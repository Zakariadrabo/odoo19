<odoo>
    <data>
        <record id="view_efund_investment_transaction_list" model="ir.ui.view">
            <field name="name">efund.investment.transaction.list</field>
            <field name="model">efund.investment.transaction</field>
            <field name="arch" type="xml">
                <list string="Transactions d'Investissement"
                      decoration-info="state == 'confirmed'"
                      decoration-warning="state == 'draft'"
                      decoration-success="state == 'settled'"
                      decoration-danger="state == 'cancelled'">

                    <!-- Colonne de référence -->
                    <field name="order_id" string="Ordre"/>

                    <!-- Informations de base -->
                    <field name="vehicule_id" string="Portefeuille"/>
                    <field name="instrument_id" string="Instrument"/>

                    <!-- Date et état -->
                    <field name="date_transaction" string="Date Transaction"/>
                    <field name="date_settlement" string="Date Règlement"/>

                    <!-- État -->
                    <field name="state" string="Statut" widget="badge"
                           options="{'classes': {'draft': 'warning', 'confirmed': 'info', 'settled': 'success', 'cancelled': 'danger'}}"/>

                    <!-- Détails de la transaction -->
                    <field name="quantity" string="Quantité"/>
                    <field name="price_unit" string="Prix Unitaire"/>
                    <field name="total_amount_trade" string="Montant HT"/>
                <!-- Frais -->
                    <field name="total_fees" string="Frais"/>
                    <field name="total_interest" string="Taxes"/>
                    <!-- Montants -->
                    <field name="total_amount" string="Montant Net"/>

                    <!-- Broker -->
                    <field name="broker_id" string="Courtier"/>

                    <!-- Bouton d'action -->
                    <button name="action_confirm_settlement"
                            string="Régler"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-check"
                            invisible="state in ['settled', 'cancelled']"/>
                </list>
            </field>
        </record>


        <record id="view_efund_investment_transaction_form" model="ir.ui.view">
            <field name="name">efund.investment.transaction.form</field>
            <field name="model">efund.investment.transaction</field>
            <field name="arch" type="xml">
                <form string="Transaction d'Investissement">
                    <header>
                        <!-- Boutons d'action selon l'état -->
                        <button name="action_confirm_settlement" type="object"
                                string="Comptabiliser le Règlement" class="btn-primary"
                                invisible="state != 'confirmed'"/>
                        <field name="state" widget="statusbar"/>
                    </header>

                    <sheet>
                        <!-- Informations principales en 2 colonnes -->
                        <group>
                            <group string="Transaction">
                                <!-- Ordre parent -->
                                <field name="order_id" options="{'no_create': True}"
                                       context="{'default_state': 'confirmed'}"/>
                                <!-- Portefeuille et Instrument -->
                                <field name="vehicule_id" readonly="1"/>
                                <field name="instrument_id" readonly="1"/>
                                <field name="operation_type" invisible="1"/>

                                <!-- Dates -->
                                <field name="date_transaction" string="Date de Transaction"/>
                                <field name="date_settlement" string="Date de dénouement"/>
                            </group>

                            <group string="Détails Financiers">
                                <!-- Quantité et Prix -->
                                <field name="quantity" string="Quantité exécutée" invisible="operation_type  == 'deposit'"/>
                                <field name="price_unit" string="Prix d'exécution" invisible="operation_type  == 'deposit'"/>
                                <field name="deposit_amount" string="Montant DAT" invisible="operation_type  != 'deposit'"/>
                                <field name="negotiated_rate" string="taux DAT" invisible="operation_type  != 'deposit'"/>
                                <field name="start_date" string="Début" invisible="operation_type  != 'deposit'"/>
                                <field name="maturity_date" string="Maturité" invisible="operation_type  != 'deposit'"/>

                                <!-- Frais -->
                                <field name="total_amount_trade" string="Total transaction" invisible="operation_type  == 'deposit'"/>
                                <field name="total_amount" string="Montant Net" readonly="1"/>

                                <!-- Courtier -->
                                <field name="broker_id" string="Société de Bourse" options="{'no_create': True}"/>
                            </group>
                        </group>

                        <!-- Informations complémentaires -->
                        <span class="text-muted">Détail calcul</span>
                        <hr/>
                        <div class="border rounded p-3">
                                <div class="row">
                                    <div class="col-6">
                                        <strong>Montant Brut :</strong>
                                        <span class="float-end">
                                            <field name="total_amount_trade"/>
                                        </span>
                                    </div>
                                    <div class="col-6">
                                        <strong>Frais totaux :</strong>
                                        <span class="float-end"><strong> Intérêt Brut : </strong><field name="total_interet_brut" string="Intérêt brut"/></span>
                                             <span class="float-end"><strong>IVRM : </strong><field name="total_irvm" string="IRVM"/></span>
                                             <span class="float-end"><strong>Intérêt Net: </strong><field name="total_interest" string="Intérêt net"/></span>
                                            <span class="float-end"><strong>Bourse: </strong><field name="total_bvm" string="Bourse"/></span>
                                            <span class="float-end"><strong>Dépositaire Central: </strong><field name="total_dc" string="Dépositaire"/></span>
                                            <span class="float-end"><strong>Régulateur: </strong><field name="total_regulateur" string="Régulateur"/></span>
                                            <span class="float-end"><strong>Courtage: </strong><field name="total_courtage" string="Courtage"/></span>
                                            <span class="float-end"><strong>Tva: </strong><field name="total_tva" string="TVA"/></span>

                                    </div>
                                </div>
                                <hr/>
                                <div class="row">
                                    <div class="col-12">
                                        <strong>Montant Net :</strong>
                                        <span class="float-end">
                                            <field name="total_amount"/>
                                        </span>
                                    </div>
                                </div>
                            </div>


                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
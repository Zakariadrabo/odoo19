<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_efund_fiscal_year_tree" model="ir.ui.view">
        <field name="name">efund.fiscal.year.tree</field>
        <field name="model">efund.fiscal.year</field>
        <field name="arch" type="xml">
            <list string="Exercices Fiscaux" decoration-info="state == 'draft'" decoration-muted="state == 'closed'">
                <field name="name"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state" widget="badge" decoration-success="state == 'draft'"
                       decoration-danger="state == 'closed'"/>
            </list>
        </field>
    </record>
    <record id="view_efund_fiscal_year_form" model="ir.ui.view">
        <field name="name">efund.fiscal.year.form</field>
        <field name="model">efund.fiscal.year</field>
        <field name="arch" type="xml">
            <form string="Exercice Fiscal">
                <header>
                    <button name="action_close" string="Clôturer l'exercice" type="object"
                            class="oe_highlight" invisible="state == 'closed'"/>
                    <button name="action_reopen" string="Rouvrir" type="object"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Nom de l'exercice"/>
                        <h1>
                            <field name="name" placeholder="ex: Exercice 2026"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Période">
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>

                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
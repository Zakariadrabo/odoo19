<odoo>
    <record id="view_efund_investor_form" model="ir.ui.view">
        <field name="name">efund.investor.form.enhanced</field>
        <field name="model">efund.investor</field>
        <field name="arch" type="xml">
            <form string="Investisseur" class="efund-investor-form">
                <!-- ==================== HEADER OPTIMISÉ ==================== -->
                <header>
                    <!-- Workflow KYC -->
                    <div class="o_statusbar_buttons d-flex flex-wrap gap-2">
                        <button name="action_submit_kyc" type="object"
                                string="Verifier KYC" class="btn-primary"
                                icon="fa-paper-plane"
                                invisible="status != 'kyc_approved'"/>

                        <div class="btn-group" role="group" invisible="status != 'draft'">
                            <button name="action_approve_kyc" type="object"
                                    string="Approuver" class="btn-success"
                                    icon="fa-check"/>
                            <button name="action_reject_kyc" type="object"
                                    string="Rejeter" class="btn-danger"
                                    icon="fa-times"/>
                        </div>

                        <button name="action_archive" type="object"
                                string="Archiver" class="btn-secondary"
                                icon="fa-archive"
                                invisible="status not in ['kyc_approved', 'kyc_rejected']"/>

                        <button name="open_join_fund_wizard"
                                string="Adhérer à un Fonds"
                                type="object"
                                class="btn-primary"
                                invisible="status !='kyc_approved'"/>
                        <button name="action_print"
                                type="object"
                                string="Print KYC"
                                class="btn-secondary"
                        />
                        <button name="%(action_investor_portfolio_report_wizard)d"
                                string="État du portefeuille"
                                type="action"
                                class="oe_highlight"
                                invisible="status !='1'"
                                icon="fa-file-pdf"/>
                    </div>

                    <!-- Barre de statut améliorée -->
                    <field name="status" widget="statusbar"
                           statusbar_visible="draft,kyc_pending,kyc_approved,kyc_rejected,archived"/>
                </header>

                <!-- ==================== SHEET PRINCIPAL ==================== -->
                <sheet>
                    <!-- En-tête avec avatar et informations clés -->
                    <div class="oe_title d-flex align-items-start mb-4">
                        <div class="me-2">
                            <field name="image_1920" widget="image" class="oe_avatar_large"
                                   options="{'preview_image': 'image_1920', 'size': [192, 192]}"/>
                        </div>
                        <div class="flex-grow-1">
                            <field name="investor_type" widget="radio" options="{'horizontal': true}"/>
                            <h1>
                                <field name="full_name" invisible="investor_type != 'individual'" class="text-success"/>
                                <field name="company_name" invisible="investor_type != 'company'" class="text-success"/>
                            </h1>
                            <div class="row mt-2">
                                <group>
                                    <group invisible="investor_type != 'individual'">
                                        <field name="nom"/>
                                        <field name="prenom"/>
                                        <field name="sex" widget="radio" options="{'horizontal': true}"/>
                                        <field name="birthdate"/>
                                        <field name="birthplace"/>
                                        <field name="birth_country_id"/>
                                    </group>
                                    <group invisible="investor_type != 'company'">
                                        <field name="company_name" required="investor_type == 'company'"/>
                                        <field name="company_address" required="investor_type  == 'company'"/>
                                        <field name="company_town" required="investor_type  == 'company'"/>
                                        <field name="company_country_id" required="investor_type  == 'company'"/>
                                        <field name="identical_address"/>
                                        <field name="company_direction_address" invisible="identical_address"
                                               required="not identical_address"/>
                                        <field name="company_direction_town" invisible="identical_address"
                                               required="not identical_address"/>
                                        <field name="company_direction_country_id" invisible="identical_address"
                                               required="not identical_address"/>
                                    </group>
                                </group>

                            </div>
                        </div>
                    </div>

                    <!-- Smart buttons avec statistiques -->
                    <div class="oe_button_box">
                        <div class="row g-2">
                            <div class="col-3">
                                <button class="oe_stat_button w-100 h-100" name="action_open_deposit" type="object">
                                    <div class="d-flex align-items-center">
                                        <i class="fa fa-money fa-2x me-3 text-primary"></i>
                                        <div>
                                            <div class="o_stat_value">
                                                <field name="deposit_count" widget="statinfo"/>
                                            </div>
                                            <div class="o_stat_text">Dépôts</div>
                                        </div>
                                    </div>
                                </button>
                            </div>
                            <div class="col-3">
                                <button class="oe_stat_button w-100 h-100" name="action_open_subscriptions"
                                        type="object">
                                    <div class="d-flex align-items-center">
                                        <i class="fa fa-line-chart fa-2x me-3 text-success"></i>
                                        <div>
                                            <div class="o_stat_value">
                                                <field name="subscription_count" widget="statinfo"/>
                                            </div>
                                            <div class="o_stat_text">Souscriptions</div>
                                        </div>
                                    </div>
                                </button>
                            </div>
                            <div class="col-3">
                                <button class="oe_stat_button w-100 h-100" name="action_open_redemption" type="object">
                                    <div class="d-flex align-items-center">
                                        <i class="fa fa-exchange fa-2x me-3 text-warning"></i>
                                        <div>
                                            <div class="o_stat_value">
                                                <field name="redemption_count" widget="statinfo"/>
                                            </div>
                                            <div class="o_stat_text">Rachats</div>
                                        </div>
                                    </div>
                                </button>
                            </div>
                            <div class="col-3">
                                <button class="oe_stat_button w-100 h-100" name="action_open_withdraw" type="object">
                                    <div class="d-flex align-items-center">
                                        <i class="fa fa-credit-card fa-2x me-3 text-info"></i>
                                        <div>
                                            <div class="o_stat_value">
                                                <field name="withdraw_count" widget="statinfo"/>
                                            </div>
                                            <div class="o_stat_text">Retraits</div>
                                        </div>
                                    </div>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Score de conformité en bandeau -->
                    <div class="alert mb-4" role="alert">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <strong>Score de conformité:</strong>
                                <field name="compliance_score" class="ms-2"/>
                                / 100
                                <span class="badge ms-2">
                                    <field name="compliance_status"/>
                                </span>
                            </div>
                            <div>
                                <small class="text-muted">
                                    Dernière mise à jour:
                                    <field name="kyc_last_update"/>
                                </small>
                            </div>
                        </div>
                        <div class="progress mt-2" style="height: 10px;">
                            <div class="progress-bar" role="progressbar">
                            </div>
                        </div>
                    </div>

                    <!-- ==================== NOTEBOOK PRINCIPAL ==================== -->
                    <notebook>
                        <!-- Onglet 1: Identité -->
                        <page string="Identité">
                            <group>
                                <group string="Informations Personnelles" invisible="investor_type != 'individual'">
                                    <field name="civilite"/>
                                    <field name="nationality"/>
                                    <field name="other_nationnality"/>
                                    <field name="marital_status"/>
                                </group>
                                <group invisible="investor_type != 'company'">
                                    <field name="company_short_name"/>
                                    <field name="legal_form" required="investor_type == 'company'"/>
                                    <field name="license_number" required="investor_type == 'company'" string="Registre de commerce"/>
                                    <field name="creation_date" required="investor_type == 'company'"/>
                                    <field name="mobility_phone" widget="phone"/>
                                    <field name="place_phone" widget="phone"/>
                                    <field name="email" widget="email"/>
                                </group>
                                <group string="Type d'investisseur">
                                    <field name="account_type_titre" string="Type de compte" required="1"/>
                                    <field name="investor_category" string="Catégorie investisseur" required="1"/>
                                    <field name="account_investor_type" string="Type d'investisseur" required="1"/>
                                </group>
                            </group>

                            <!-- Coordonnées (commun) -->
                            <group string="Coordonnées" invisible="investor_type != 'individual'">
                                <group>
                                    <field name="address"/>
                                    <field name="address_place"/>
                                    <field name="country_id"/>
                                    <field name="contact_adress"/>
                                </group>
                                <group>
                                    <field name="mobility_phone" widget="phone"/>
                                    <field name="place_phone" widget="phone"/>
                                    <field name="email" widget="email"/>
                                </group>
                            </group>
                        </page>

                        <!-- Onglet 2: Profil Financier -->
                        <page string="Profil Financier">
                            <group>
                                <group string="Situation Professionnelle" invisible="investor_type != 'individual'">
                                    <field name="activite"/>
                                    <field name="other_activite" invisible="activite != 'other'"/>
                                    <field name="profession"/>
                                    <field name="function"/>
                                    <field name="employer"/>
                                    <field name="employer_address"/>
                                    <field name="activity_sector"/>
                                    <field name="socio_professional_category"/>
                                </group>
                                <group string="Paramètres Financiers" invisible="investor_type != 'individual'">
                                    <field name="revenu"/>
                                    <field name="estimation"/>
                                    <field name="origine"/>
                                    <field name="other_origine" invisible="origine != 'other'"/>
                                    <field name="objectif"/>
                                    <field name="other_objectif" invisible="objectif != 'other'"/>
                                    <field name="periodicite"/>
                                    <field name="montant_mois"/>
                                </group>
                            </group>

                            <group string="Entreprise" invisible="investor_type != 'company'">
                                <group>
                                    <field name="social_object"/>
                                    <field name="activity_sector"/>
                                    <field name="annual_turnover_range"/>
                                    <field name="main_revenue_sources"/>
                                    <field name="funds_origin_pm"/>
                                    <field name="funds_origin_pm_other" invisible="funds_origin_pm != 'other'"/>
                                </group>
                                <group>
                                    <field name="expected_operations_volume"/>
                                    <field name="main_activity_countries" widget="many2many_tags"/>
                                    <field name="website"/>
                                    <field name="company_duration_years"/>
                                    <field name="is_beneficiaire_effectif"/>
                                    <field name="beneficiaire_effectif" invisible="not is_beneficiaire_effectif"/>
                                </group>
                            </group>
                        </page>

                        <!-- Onglet 3: Relations -->
                        <page string="Relations">
                            <group>
                                <group string="Informations Relation">
                                    <field name="entry_relation_date"/>
                                    <field name="business_object_relation"/>
                                    <field name="fund_country_origin"/>
                                    <field name="fund_country_destination"/>
                                </group>
                                <group string="Connaissances">
                                    <field name="market_knowledge" widget="priority"/>
                                    <field name="activity_knowledge" widget="priority"/>
                                    <field name="risk_level_acceptable" widget="priority"/>
                                </group>
                            </group>

                            <!-- Personnes représentées -->
                            <group string="Personnes Représentées">
                                <field name="represented_person_ids">
                                    <list editable="bottom">
                                        <field name="relationship"/>
                                        <field name="full_name"/>
                                        <field name="lien_client"/>
                                        <field name="phone" widget="phone"/>
                                        <field name="document_type"/>
                                        <field name="document_number"/>
                                    </list>
                                </field>
                            </group>
                        </page>

                        <!-- Onglet 4: Bancaire -->
                        <page string="Bancaire">
                            <group>
                                <group string="Coordonnées Bancaires">
                                    <field name="name_bank"/>
                                    <field name="bank_address"/>
                                    <field name="account_number"/>
                                </group>
                                <group string="Identifiants">
                                    <field name="iban"/>
                                    <field name="swift_bic"/>
                                </group>
                            </group>
                        </page>

                        <!-- Onglet 5: Documents KYC -->
                        <page string="Documents">
                            <field name="document_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="document_type" widget="selection"/>
                                    <field name="issued_date"/>
                                    <field name="expiry_date"/>
                                    <field name="state" widget="badge"/>
                                    <field name="file_data" widget="binary" filename="file_name_fname"/>
                                </list>
                            </field>
                        </page>

                        <!-- Onglet 6: AML & Surveillance -->
                        <page string="Surveillance">
                            <group>
                                <group string="Indicateurs Risque">
                                    <field name="pep_flag" widget="boolean"/>
                                    <field name="sanctions_flag" widget="boolean"/>
                                    <field name="whitelisted" widget="boolean"/>
                                    <field name="risk_category"/>
                                </group>
                            </group>

                            <group string="Alertes AML">
                                <field name="aml_alert_ids">
                                    <list>
                                        <field name="name"/>
                                        <field name="severity" widget="badge"
                                               options="{'classes': {'low': 'info', 'medium': 'warning', 'high': 'danger'}}"/>
                                        <field name="status" widget="badge"/>
                                        <field name="created_at"/>
                                    </list>
                                </field>
                            </group>
                        </page>

                        <!-- Onglet 7: Comptes -->
                        <page string="Comptes">
                            <br />
                            <div class="row">
                                <div class="col-5">
                                    <field name="cash_account_ids">
                                        <list create="false">
                                            <field name="account_number"/>
                                            <field name="vehicule_id" />
                                            <field name="balance" widget="monetary"/>
                                        </list>
                                    </field>
                                </div>
                                <div class="col-2" />
                                <div class="col-5">
                                    <field name="part_account_ids">
                                        <list create="false">
                                            <field name="account_number"/>
                                            <field name="vehicule_id" />
                                            <field name="total_parts"/>
                                        </list>
                                    </field>
                                </div>
                            </div>
                        </page>
                    </notebook>
                </sheet>

                <!-- Chatter -->
                <chatter>
                    <field name="message_follower_ids" widget="followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </chatter>
            </form>
        </field>
    </record>

    <record id="view_efund_investor_tree" model="ir.ui.view">
        <field name="name">efund.investor.list</field>
        <field name="model">efund.investor</field>
        <field name="arch" type="xml">
            <list string="Investisseurs"
                  decoration-info="status == 'draft'"
                  decoration-warning="status == 'kyc_pending'"
                  multi_edit="1">

                <field name="investor_type" widget="badge"
                       decoration-muted="investor_type == 'individual'"
                       decoration-info="investor_type == 'company'"/>
                <field name="full_name" invisible="investor_type != 'individual'" optional="show"/>
                <field name="company_name" invisible="investor_type != 'company'" optional="show"/>
                <field name="email" widget="email"/>
                <field name="phone" widget="phone"/>
                <field name="country_id" optional="hide"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'approved'"
                       decoration-warning="status == 'kyc_pending'"
                       decoration-info="status == 'draft'"
                       decoration-danger="status == 'rejected'"/>

            </list>
        </field>
    </record>


</odoo>
<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_efund_event_type_form" model="ir.ui.view">
        <field name="name">efund.event.type.form</field>
        <field name="model">efund.event.type</field>
        <field name="arch" type="xml">
            <form string="Type d'Événement">
                <header>
                    <button name="action_validate" string="Valider" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_archived" string="Archiver" type="object"
                            invisible="state == 'archived'"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,validated,archived"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Nom du type d'événement"/>
                        <h1>
                            <field name="name" placeholder="ex: Souscription Validée"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="sigle" placeholder="ex: SUB_VALIDATED"/>
                        </group>
                        <group>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_efund_event_type_tree" model="ir.ui.view">
        <field name="name">efund.event.type.list</field>
        <field name="model">efund.event.type</field>
        <field name="arch" type="xml">
            <list string="Types d'Événements">
                <field name="name"/>
                <field name="sigle"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'validated'"
                       decoration-muted="state == 'archived'"/>
            </list>
        </field>
    </record>

</odoo>
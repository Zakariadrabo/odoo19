<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_gestion_vehicule_form" model="ir.ui.view">
        <field name="name">efund.vehicule.form</field>
        <field name="model">efund.vehicule.fund</field>
        <field name="arch" type="xml">
            <form string="OPCVM" class="o_xxl_form_view">
                <header>
                    <button name="action_activate" type="object"
                            string="Activer"
                            class="btn-primary oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_suspend" type="object"
                            string="Suspendre"
                            class="btn-warning"
                            invisible="state != 'active'"/>
                    <button name="action_liquidate" type="object"
                            string="Liquider"
                            class="btn-danger"
                            invisible="state in ['draft', 'liquidated'] "/>
                    <button name="action_reset_to_draft" type="object"
                            string="Remettre en brouillon"
                            invisible="state == 'draft' "/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,suspended,liquidated"/>
                </header>
                <sheet>
                    <div class="p-3 mb-3 border rounded bg-light border-info" invisible="state != 'draft'">
                        <div class="d-flex align-items-center">
                            <i title="info" class="fa fa-info-circle fa-2x text-info mr-3"/>
                            <div>
                                <strong>Mode Brouillon :</strong>
                                Ce véhicule d'investissement n'est pas encore actif.
                                Veuillez configurer les paramètres ISIN et la devise avant l'activation.
                            </div>
                        </div>
                    </div>

                    <div class="oe_title">
                        <label for="name" string="Nom de l'OPCVM"/>
                        <h1>
                            <field name="name" placeholder="Ex: FCP E-FUND ACTIONS UEMOA"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Identité &amp; Classification">
                            <field name="isin" placeholder="ex: QS000..."/>
                            <field name="fund_type_id" string="Classe d'OPCVM"/>
                            <field name="management_company_id" options="{'no_create': True}"/>
                        </group>
                        <group string="Gestion &amp; Dates">
                            <field name="depositary_id"/>
                            <field name="created_date"/>
                            <field name="start_date"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Informations Générales">
                            <group>
                                <field name="nav_frequency" />
                                <field name="origin_nav" placeholder="Sasir la VL initiale ..."/>
                            </group>
                            <group>
                                <field name="cutoff_time" placeholder="Heure de calcul de la VL..."/>
                                <field name="allow_fractional_parts" placeholder="Autoriser parts fractionnées ?"/>
                            </group>
                        </page>
                        <page string="Politique d'Investissement" name="policy" invisible="1">
                            <div class="o_horizontal_separator text-primary mt-3 mb-3"
                                 style="font-weight: bold; font-size: 1.2em;">
                                Objectifs du Fonds
                            </div>
                            <group>
                                <!-- <field name="investment_objective" nolabel="1" placeholder="Décrivez ici la stratégie du fonds..."/> -->
                            </group>
                        </page>

                        <page string="Catégorie de parts">
                            <field name="share_class_ids" context="{'default_vehicule_fund_id': id}">
                                <list>
                                    <field name="name"/>
                                    <field name="management_fee_rate"/>
                                    <field name="entry_load"/>
                                    <field name="exit_load"/>
                                    <field name="performance_fee_rate"/>
                                    <field name="minimum_subscription"/>
                                    <field name="minimum_additional_subscription"/>
                                    <field name="minimum_redemption"/>
                                    <field name="current_nav"/>
                                    <field name="is_default"/>
                                </list>
                            </field>
                        </page>
                        <page string="Portefeuilles">
                            <header>
                                <button name="action_revalue_positions"
                                        string="Actualiser la Valorisation"
                                        type="object"
                                        icon="fa-refresh"
                                        class="btn-secondary mb-2"/>
                            </header>
                            <field name="position_ids" readonly="1">
                                <list string="Inventaire des Titres">
                                    <field name="instrument_id"/>
                                    <field name="last_price_date"/>
                                    <field name="quantity"/>
                                    <field name="last_price"/>
                                    <field name="avg_cost" string="CMUP"/>
                                    <field name="issuance_price"/>
                                    <field name="market_value" sum="Total"/>
                                    <field name="unrealized_pl" sum="Total PV Latente"
                                           decoration-success="unrealized_pl &gt; 0"
                                           decoration-danger="unrealized_pl &lt; 0"/>
                                </list>
                            </field>
                        </page>
                        <page string="Charges du fond">
                            <field name="expenses_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="expense_type"/>
                                    <field name="partner_id"/>
                                    <field name="frequency"/>
                                    <field name="calculation_method"/>
                                    <field name="amount"/>
                                    <field name="rate"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Flux de trésorerie">
                            <header>
                                <button name="generate_excel"
                                        type="object"
                                        class="btn-primary"
                                        icon="fa-calculator"
                                        string="Export sous excel"/>
                            </header>
                            <field name="vehicule_cash_move_ids" readonly="1">
                                <list>
                                    <field name="date" string="Date"/>
                                    <field name="label" string="Opération"/>
                                    <field name="amount" string="Débit" invisible="'_in' in move_type "/>
                                    <field name="amount" string="Crédit" invisible="'_out' in move_type "/>
                                    <field name="balance_running" string="Solde"/>
                                </list>
                            </field>
                        </page>
                        <page string="Echéanciers">
                            <field name="cashflow_ids" readonly="1">
                                <list>
                                    <field name="date_scheduled" string="Date prévue"/>
                                    <field name="amount_expected" string="Montant attendu"/>
                                    <field name="flow_type" string="Type de flux"/>
                                    <field name="state" string="État"/>
                                </list>
                            </field>
                        </page>
                        <page string="Calendrier des Flux à venir" name="cashflow_projection">
                            <field name="all_portfolio_cashflows" readonly="1">
                                <list decoration-success="principal > 0"
                                      decoration-bf="date &lt;= context_today() + relativedelta(days=7)">
                                    <field name="date"/>
                                    <field name="portfolio_id" string="Titre"/>
                                    <field name="interet" string="Coupon Attendu" sum="Total Coupons"/>
                                    <field name="principal" string="Remboursement Cap." sum="Total Capital"/>
                                    <field name="annuite" string="Total à percevoir" sum="Total Général"
                                           class="fw-bold"/>
                                    <button name="get_position_form" type="object" icon="fa-search-plus"
                                            title="Détail Position"/>
                                </list>
                            </field>
                        </page>
                        <page string="Positions">
                            <header>
                                <button name="action_revalue_positions"
                                        string="Actualiser la Valorisation"
                                        type="object"
                                        icon="fa-refresh"
                                        class="btn-secondary mb-2"/>
                            </header>
                            <field name="position_ids" readonly="1">
                                <list string="Inventaire des Titres">
                                    <field name="instrument_id"/>
                                    <field name="last_price_date"/>
                                    <field name="quantity"/>
                                    <field name="last_price"/>
                                    <field name="avg_cost" string="CMUP"/>
                                    <field name="first_price"/>
                                    <field name="market_value" sum="Total"/>
                                    <field name="unrealized_pl" sum="Total PV Latente"
                                           decoration-success="unrealized_pl &gt; 0"
                                           decoration-danger="unrealized_pl &lt; 0"/>
                                    <button name="action_generate_specific_amortization"
                                            type="object"
                                            string="Générer Échéancier"
                                            icon="fa-cogs"
                                            class="btn-secondary"/>
                                </list>
                            </field>
                        </page>

                        <page string="Configuration Comptable" name="accounting" groups="account.group_account_manager">
                            <div class="p-3 mb-2 border-left border-info bg-light">
                                <i class="fa fa-university text-info mr-2"/>
                                Paramètres de liaison avec la comptabilité analytique de la société de gestion.
                            </div>
                            <group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Vue liste/arbre -->
    <record id="view_gestion_vehicle_list" model="ir.ui.view">
        <field name="name">gestion.vehicule.list</field>
        <field name="model">efund.vehicule.fund</field>
        <field name="arch" type="xml">
            <list string="Véhicules de Gestion" decoration-success="state=='active'"
                  decoration-warning="state=='suspended'" decoration-danger="state=='liquidated'"
                  decoration-muted="state=='draft'">
                <!-- Colonnes principales avec icônes -->
                <field name="name" string="Nom" widget="handle"/>
                <field name="vehicle_type" widget="badge"
                       options="{'success': 'fund', 'info': 'mandate'}"/>
                <field name="state" widget="badge"
                       options="{'success': 'active', 'warning': 'suspended', 'danger': 'liquidated', 'secondary': 'draft'}"/>
                <field name="company_id" widget="many2one_avatar"/>
                <field name="management_company_id" widget="many2one_avatar"/>
                <field name="currency_id" widget="many2one_avatar"/>
                <field name="isin"/>
                <field name="created_date" widget="date"/>
                <field name="start_date" widget="date"/>

                <!-- Boutons d'action rapide -->
                <button name="action_activate" type="object" icon="fa-check"
                        string="Activer" class="btn-link"
                        invisible="state != 'draft' "/>
                <button name="action_suspend" type="object" icon="fa-pause"
                        string="Suspendre" class="btn-link"
                        invisible="state != 'active' "/>
            </list>
        </field>
    </record>


</odoo>
<odoo>

    <record id="view_efund_investment_order_list" model="ir.ui.view">
        <field name="name">efund.investment.order.list</field>
        <field name="model">efund.investment.order</field>
        <field name="arch" type="xml">
            <list string="Ordres d'Investissement" decoration-info="state=='confirmed'"
                  decoration-warning="state=='draft'" decoration-danger="state=='cancelled'">
                <!-- Colonne principale avec état coloré -->
                <field name="name" string="Référence"/>

                <!-- Colonne d'état avec indicateur visuel -->
                <field name="state" widget="selection_badge"
                       options="{'classes': {'draft': 'warning', 'confirmed': 'info', 'executed': 'success', 'cancelled': 'danger'}}"/>

                <!-- Informations principales -->
                <field name="vehicule_id" string="Portefeuille"/>
                <field name="instrument_id" string="Instrument"/>
                <field name="operation_type" string="Type Opération" widget="selection"/>

                <!-- Colonnes conditionnelles selon le type d'opération -->
                <field name="direction" string="Sens"/>

                <!-- Montants avec formatage conditionnel -->
                <field name="quantity" string="Quantité" invisible="operation_type not in ['trade']"/>
                <field name="order_amount" string="Montant OPCVM"
                       invisible="operation_type not in ['subscription', 'redemption']"/>
                <field name="deposit_amount" string="Montant DAT" invisible="operation_type != 'deposit'"/>
                <field name="total_amount_trade" string="Montant Total" invisible="operation_type not in ['trade']"/>

                <!-- Informations de prix et date -->
                <field name="limit_price" string="Prix" invisible="operation_type != 'trade'"/>
                <field name="price_type" string="Type Prix" invisible="operation_type != 'trade'"/>

                <!-- Dates importantes -->
                <field name="validity_date" string="Validité" invisible="operation_type != 'trade'"/>
                <field name="nav_date_expected" string="Date VL"
                       invisible="operation_type not in ['subscription', 'redemption']"/>
                <field name="maturity_date" string="Échéance" invisible="operation_type != 'deposit'"/>
            </list>
        </field>
    </record>

    <record id="view_efund_investment_order_form" model="ir.ui.view">
        <field name="name">efund.investment.order.form</field>
        <field name="model">efund.investment.order</field>
        <field name="arch" type="xml">
            <form string="Ordre d'investissement" readonly="state == 'cancelled'">
                <header>
                    <button name="action_cancel" type="object" string="Annuler" class="btn-danger"
                            invisible="state in ('draft','executed','cancelled')"/>
                    <button name="action_validate" type="object" string="Valider" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_send" type="object" string="Envoyer" class="btn-primary"
                            invisible="state != 'validated'"/>
                    <button name="action_execute" type="object" string="Executé" class="btn-primary"
                            invisible="state not in ('sent', 'partially_executed')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Contexte">
                            <field name="vehicule_id" options="{'no_create': True}"/>
                            <field name="instrument_id" options="{'no_create': True}"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="operation_type"/>
                            <field name="order_date" required="True"/>
                        </group>
                        <group string="Exécution" invisible="operation_type not in ( 'trade', 'opcvm')">
                            <field name="direction" invisible="operation_type != 'trade'"
                                   required="operation_type == 'trade'"
                                   widget="radio" options="{'horizontal': true}"/>
                            <field name="broker_id" invisible="operation_type != 'trade'"
                                   required="operation_type == 'trade'"/>
                            <field name="direction_opcvm" invisible="operation_type != 'opcvm'"
                                   required="operation_type == 'opcvm'"
                                   widget="radio" options="{'horizontal': true}"/>
                            <field name="rate" invisible="operation_type not in ( 'trade', 'opcvm')"/>
                            <field name="tva_rate" invisible="operation_type not in ( 'trade', 'opcvm')"/>

                        </group>
                    </group>

                    <group string="Détails de Marché" invisible="operation_type != 'trade' or instrument_type =='tcn'">
                        <group>
                            <field name="price_type"/>
                            <field name="quantity"/>
                            <field name="limit_price"/>
                        </group>
                        <group>
                            <field name="total_amount_trade" widget="monetary" class="fw-bold text-primary" force_save="1"/>
                            <field name="total_amount"/>
                            <field name="total_fees" invisible="instrument_type in('tcn','opcvm')"/>
                            <field name="total_interest" readonly="1" invisible="instrument_type in('equity','opcvm')"/>
                        </group>
                    </group>
                    <group string="Détails de Marché" invisible="operation_type != 'trade' or instrument_type !='tcn'">
                        <group string="Détails de la Négociation" class="oe_edit_only"
                               style="background-color: #f8f9fa; padding: 10px; border-radius: 5px;">
                            <field name="calculation_type" widget="radio" options="{'horizontal': true}" string="Choix du rendement"/>
                            <field name="quantity"/>
                            <field name="yield_rate" readonly="calculation_type != 'rate'" force_save="1"  class="oe_inline" string="Rendement %"/>
                            <field name="purchase_price" readonly="calculation_type != 'amount'" widget="monetary" class="fw-bold text-primary" string="Prix d'acquisition Nominal" force_save="1"/>
                            <field name="discount_amount" readonly="1" force_save="1" string="rendement Prix / Bon"/>
                        </group>

                        <group string="Résumé">
                            <field name="total_amount_trade" widget="monetary" class="fw-bold text-primary"
                                   string="Montant Transaction" force_save="1"/>
                            <field name="total_interest" readonly="1" string="Intérêt Précompté"/>
                            <field name="total_courtage" readonly="1" widget="monetary" class="fw-bold text-primary"
                                   string="Montant Courtage" force_save="1"/>
                            <field name="total_tva" readonly="1" widget="monetary" class="fw-bold text-primary"
                                   string="Montant TVA" force_save="1"/>
                            <field name="total_amount" string="Montant à payer"/>
                        </group>
                    </group>

                    <group string="Conditions du DAT" invisible="operation_type != 'deposit'">
                        <group>
                            <field name="deposit_amount" widget="monetary"/>
                            <field name="negotiated_rate" widget="float"/>
                            <field name="interest_type"/>
                            <field name="start_date"/>
                            <field name="maturity_date"/>
                        </group>
                        <group>
                            <field name="total_interet_brut"/>
                            <field name="total_irvm"/>
                            <field name="total_interest"/>
                            <field name="total_amount"/>
                        </group>
                    </group>
                    <group string="Commission / Taxe / Intérêts courus"
                           invisible="operation_type != 'trade' or instrument_type =='tcn'">
                        <group>
                            <field name="instrument_type" invisible="1"/>
                            <field name="total_interet_brut" invisible="instrument_type == 'equity'"/>
                            <field name="total_irvm" invisible="instrument_type == 'equity'"/>
                            <field name="total_interest" invisible="instrument_type == 'equity'"/>
                            <field name="total_amount_trade" force_save="1"/>
                            <field name="total_bvm"/>
                            <field name="total_dc"/>

                        </group>
                        <group>
                            <field name="total_regulateur"/>
                            <field name="total_courtage"/>
                            <field name="total_tva"/>
                            <field name="total_commission" invisible="instrument_type == 'equity'"/>
                            <field name="total_amount"/>
                        </group>
                    </group>

                    <group string="Détails de l'Ordre OPCVM" invisible="operation_type != 'opcvm'">
                        <div class="alert alert-info" role="alert" colspan="2" style="margin-bottom:10px;">
                            <i class="fa fa-info-circle"/>
                            Exécution à Valeur Liquidative connue.
                        </div>
                        <group>
                            <field name="amount_type" widget="radio" options="{'horizontal': true}"/>
                            <field name="order_amount" widget="monetary" string="Montant Brut"
                                   readonly="amount_type == 'unit'" force_save="1"/>
                            <field name="nav" string="Valeur liquidative"/>
                            <field name="nav_date_expected"/>
                            <field name="units_estimated" class="text-muted" readonly="amount_type == 'amount'"
                                   force_save="1"/>
                        </group>
                        <group>
                            <field name="total_amount_trade" readonly="1" force_save="1"/>
                            <field name="total_amount" readonly="1"/>
                        </group>

                    </group>
                    <notebook>
                        <page string="Exécutions / Transactions" name="transactions">
                            <field name="execution_line_ids">
                                <list>
                                    <field name="date_transaction"/>
                                    <field name="quantity"/>
                                    <field name="price_unit" widget="monetary"/>
                                    <field name="total_amount_trade" widget="monetary" force_save="1"/>
                                    <field name="total_fees" widget="monetary"/>
                                    <field name="total_interest" widget="monetary"/>
                                    <field name="total_amount" widget="monetary" sum="Total Net"/>
                                    decoration-info="state == 'draft'"
                                    decoration-success="state == 'settled'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Suivi Quantité" name="tracking" invisible="operation_type != 'trade'">
                            <group>
                                <field name="executed_qty" readonly="1"/>
                                <field name="remaining_qty" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter>
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </chatter>
            </form>
        </field>
    </record>

</odoo>
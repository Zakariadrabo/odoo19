<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- LIST VIEW -->
    <record id="view_efund_bourse_order_list" model="ir.ui.view">
        <field name="name">efund.bourse.order.list</field>
        <field name="model">efund.bourse.order</field>
        <field name="arch" type="xml">
            <list>
                <field name="order_date"/>
                <field name="fund_id"/>
                <field name="broker_id"/>
                <field name="instrument_id"/>
                <field name="order_sens"/>
                <field name="quantity"/>
                <field name="executed_quantity"/>
                <field name="average_execution_price"/>
                <field name="gross_amount"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_efund_bourse_order_form" model="ir.ui.view">
        <field name="name">efund.bourse.order.form</field>
        <field name="model">efund.bourse.order</field>
        <field name="arch" type="xml">
            <form string="Ordre de Bourse">
                <header>
                    <button name="action_cancel" type="object" string="Annuler" class="btn-danger"
                            invisible="state in ('draft','executed','cancelled')"/>
                    <button name="action_validate" type="object" string="Valider" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_send" type="object" string="Envoyer" class="btn-primary"
                            invisible="state != 'validated'"/>
                    <button name="action_execute" type="object" string="Executé" class="btn-primary"
                            invisible="state not in ('sent', 'partially_executed')"/>
                    <field name="state" widget="statusbar"/>
                </header>

                <sheet>
                    <group>
                        <group string="Général">
                            <field name="order_date"/>
                            <field name="fund_id"/>
                            <field name="broker_id"/>
                        </group>

                        <group string="Type d’ordre">
                            <field name="order_sens" readonly="state not in ('draft','validated')"/>
                        </group>
                    </group>
                    <group>
                        <group string="Instrument">
                            <field name="instrument_id"/>
                            <field name="symbol"/>
                            <field name="market_place"/>
                            <field name="depository"/>
                        </group>

                        <group string="Conditions">
                            <field name="quantity"/>
                            <field name="order_type"/>
                            <field name="price_limit" required="order_type in ['limit', 'threshold']"
                                   invisible="order_type == 'market'"/>
                            <field name="expiry_date"/>
                        </group>
                    </group>
                    <group>
                        <group string="Execution">
                            <field name="executed_quantity" readonly="1"/>
                            <field name="execution_price" readonly="1"/>
                            <field name="gross_amount" readonly="1"/>
                            <field name="commission_sgi" readonly="1"/>
                            <field name="commission_total" readonly="1"/>
                        </group>

                    </group>
                    <notebook>
                        <page string="Exécutions">
                            <field name="execution_line_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="execution_date"/>
                                    <field name="quantity"/>
                                    <field name="price"/>
                                    <field name="total_amount_ht"/>
                                    <field name="total_interest"/>
                                    <field name="total_broker_commission"/>
                                    <field name="total_tob_commission"/>
                                    <field name="total_amount"/>

                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter>
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </chatter>
            </form>
        </field>
    </record>
</odoo>
